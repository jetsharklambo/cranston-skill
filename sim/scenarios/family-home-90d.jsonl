# family-home-90d.jsonl - the canonical authored scenario for sim/soak.py.
# D01 == 2027-01-04 00:00 UTC (sim epoch; see sim/soak.py START). Times UTC.
# expect vocabulary: page (admin 1001 message naming the service within
# within_min, default 15), digest (flushed catch-up naming it within 29h),
# notify (either), silent (no admin messages attributable to it), announce
# (exactly-once household 2001 text), heal-ok (approve-heal ran + verified),
# all-clear (end-state: every key ok except the listed exceptions).
# Expectation notes where engine reality shaped the timeline: sim/README.md.
{"meta": true, "name": "family-home-90d", "gates": "full"}

# -- week 1: quiet baseline (G2) with one gateway blip (G7: total silence)
{"t": "D03 09:12", "ev": "gw_down", "dur_min": 22, "expect": "silent", "id": "wk1-gw-blip"}

# -- first incidents
{"t": "D08 02:40", "ev": "svc_down", "svc": "plex", "expect": "page", "id": "plex-crash-1"}
# flap storm on the plex host: one HOST_DOWN page, later notices carry the flap suffix
{"t": "D12 19:05", "ev": "flap", "host": "192.168.1.4", "n": 6, "period_min": 5, "expect": "page", "id": "wifi-flap-plexhost"}
# routine cert renewal: nothing should be said
{"t": "D15 11:00", "ev": "cert_set", "name": "truenas", "days": 40, "expect": "silent", "id": "cert-routine-renewal"}
# plex crash #2: the auto-fix notice is DEMOTED to the digest by D12's lingering
# flap counter (real engine semantics - documented in sim/README.md)
{"t": "D18 21:14", "ev": "svc_down", "svc": "plex", "expect": "digest", "id": "plex-crash-2"}

# -- dns wedge: restart runs but does not take -> attempt pages -> escalation
# -> re-nags; the wedge clears at 09:30 (resolver still down) and the admin
# heal at 09:40 fixes it (approve-heal output goes to the agent, not the phone)
{"t": "D22 07:00", "ev": "dns_wedge", "expect": "page", "id": "dns-wedge"}
{"t": "D22 09:30", "ev": "dns_ok", "id": "dns-unwedge"}
{"t": "D22 09:40", "ev": "admin_heal", "key": "pihole-dns", "expect": "heal-ok", "id": "dns-heal"}

# -- NAS host power blip: tell-page (no safe fix) + the held checkmark
{"t": "D26 13:30", "ev": "host_down", "host": "192.168.1.3", "dur_min": 45, "expect": "page", "id": "nas-power-blip"}
# router flap storm: the network gate owns this - total silence
{"t": "D33 19:00", "ev": "flap", "host": "192.168.1.1", "n": 6, "period_min": 5, "expect": "silent", "id": "router-flap"}

# -- the disk arc: tank fills +1%/day from 64% (D40) and crosses the 85%-used
# threshold at D62 (86% used = 14% free < MIN_FREE_PCT 15) -> daily digest nag
{"t": "D40 03:00", "ev": "disk_fill", "vol": "tank", "pct": 64}
{"t": "D41 03:00", "ev": "disk_fill", "vol": "tank", "pct": 65}
