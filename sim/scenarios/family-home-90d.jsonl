# -- wan outage: resolver AND upstreams dark = UPSTREAM_DOWN (degraded, not the
# resolver's fault) -> digest only
{"t": "D47 11:20", "ev": "wan_down", "dur_min": 90, "expect": "digest", "id": "wan-outage"}

# -- cert ladder: warn (digest nag, daily) -> crit (page; waits for the daily
# realert slot, hence within_min 90) -> renewed (held checkmark releases)
{"t": "D55 10:00", "ev": "cert_set", "name": "truenas", "days": 13, "expect": "digest", "id": "cert-warn"}
{"t": "D61 09:00", "ev": "cert_set", "name": "truenas", "days": 6, "expect": "page", "within_min": 90, "id": "cert-crit"}
{"t": "D63 09:00", "ev": "cert_set", "name": "truenas", "days": 364, "expect": "page", "within_min": 30, "id": "cert-renewed"}

# -- the overnight unattended ask: page + consent scope line, hourly renewals,
# demotion to the digest after ask_demote_after=3, pending kept renewed; the
# morning heal announces to the household (2001) before the fix runs
{"t": "D70 23:05", "ev": "svc_down", "svc": "truenas-smb", "expect": "page", "id": "nas-down-overnight"}
{"t": "D71 07:30", "ev": "admin_heal", "key": "truenas-smb", "expect": "announce", "id": "nas-heal"}

# -- Telegram outage: a page queued during the 500 window must survive the
# retries and deliver exactly once after recovery (the 530-sends regression)
{"t": "D77 10:00", "ev": "tg_mode", "mode": "500", "dur_min": 50, "id": "tg-outage"}
{"t": "D77 10:05", "ev": "dns_down", "expect": "page", "within_min": 60, "id": "dns-crash-tg-window"}

# -- probe-path regression: only the primary listener dies; the alt transport
# proves the service fine -> LAN_UNREACHABLE degraded digest, never a page
{"t": "D84 10:00", "ev": "svc_down", "svc": "plex-primary", "dur_min": 120, "expect": "digest", "id": "plex-lan-path"}

# -- end: everything healed except the disk, which nobody ever emptied
{"t": "D90 23:00", "ev": "end", "expect": "all-clear", "except": ["truenas-disk"]}
