{
  "version": 2,
  "paths": {
    "state_dir": "state",
    "audit_log": "state/audit.log",
    "digest_file": "state/digest.jsonl",
    "alert_sink": "bin/send-alert.sh",
    "approval_gate": null
  },
  "defaults": {
    "fail_threshold": 2,
    "check_timeout_seconds": 45,
    "cooldown_minutes": 30,
    "max_attempts": 2,
    "attempt_window_hours": 6,
    "verify_delay_seconds": 45,
    "realert_minutes": 60,
    "recovery_hold_minutes": 10,
    "pending_ttl_hours": 6,
    "post_outage_grace_minutes": 6
  },
  "services": [
    {
      "name": "media-server",
      "enabled": true,
      "_note": "Example: an HTTP service on another host, probed over two transports. The LAN_UNREACHABLE/TRANSPORT_BLIND findings are degraded and digest by default; a real HOST_DOWN pages and proposes nothing (watch-only).",
      "check": "checks/templates/check-http.sh",
      "params": {
        "CHECK_KEY": "media-server",
        "HTTP_URL": "http://192.168.1.58:4533/ping",
        "HTTP_URL_ALT": "http://100.64.0.9:4533/ping",
        "HOST_IP": "192.168.1.58"
      },
      "remediations": {
        "SERVICE_DOWN": null,
        "HOST_DOWN": null,
        "LAN_UNREACHABLE": null,
        "TRANSPORT_BLIND": null
      },
      "realert_minutes_by_code": {
        "LAN_UNREACHABLE": 1440,
        "TRANSPORT_BLIND": 1440
      }
    },
    {
      "name": "home-dns",
      "enabled": true,
      "_note": "Example: the house resolver, with upstream isolation (a WAN outage is never blamed on it) and layer isolation (its host's owner service handles host-down).",
      "check": "checks/templates/check-dns.sh",
      "params": {
        "CHECK_KEY": "home-dns",
        "RESOLVER_IP": "192.168.1.35",
        "OWNER_HOST_IP": "192.168.1.35"
      },
      "remediations": {
        "DNS_DOWN": null,
        "UPSTREAM_DOWN": null
      }
    }
  ]
}
